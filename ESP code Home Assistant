esphome:
  name: esp32-s3-dashboard
  friendly_name: ESP32 S3 Dashboard


# ============================================================
# ESP32
# ============================================================

esp32:
  board: esp32-s3-devkitc-1
  framework:
    type: esp-idf

psram:
  mode: octal


# ============================================================
# LOGGER / API / OTA
# ============================================================

logger:

api:

ota:
  - platform: esphome


# ============================================================
# WIFI
# ============================================================

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password

  ap:
    ssid: "ESP32 Dashboard"
    password: "12345678"

captive_portal:


# ============================================================
# WEB SERVER
# ============================================================

web_server:
  port: 80
  version: 3


# ============================================================
# RESTART BUTTON
# ============================================================

button:

  - platform: restart
    name: "Restart Dashboard"
    id: restart_dashboard


# ============================================================
# GLOBALS
# ============================================================

globals:

  # ----------------------------------------------------------
  # Named page IDs
  # ----------------------------------------------------------

  - id: page_klok
    type: int
    restore_value: no
    initial_value: '0'

  - id: page_zonnepanelen
    type: int
    restore_value: no
    initial_value: '1'

  - id: page_batterij
    type: int
    restore_value: no
    initial_value: '2'

  - id: page_weer
    type: int
    restore_value: no
    initial_value: '3'

  - id: page_zout
    type: int
    restore_value: no
    initial_value: '4'


  # ----------------------------------------------------------
  # Current page
  # ----------------------------------------------------------

  - id: current_page
    type: int
    restore_value: no
    initial_value: '0'


  # ----------------------------------------------------------
  # Automatic rotation pause
  # ----------------------------------------------------------

  - id: auto_rotate_pause_until
    type: uint32_t
    restore_value: no
    initial_value: '0'


  # ----------------------------------------------------------
  # Last page change
  # ----------------------------------------------------------

  - id: last_page_change
    type: uint32_t
    restore_value: no
    initial_value: '0'


  # ----------------------------------------------------------
  # Swipe protection
  # ----------------------------------------------------------

  - id: swipe_handled
    type: bool
    restore_value: no
    initial_value: 'false'


# ============================================================
# I2C
# ============================================================

i2c:

  # ----------------------------------------------------------
  # TOUCH
  # CST816
  # SDA = GPIO1
  # SCL = GPIO3
  # ----------------------------------------------------------

  - id: touch_i2c
    sda: GPIO1
    scl: GPIO3
    scan: true


  # ----------------------------------------------------------
  # TCA9554
  # SDA = GPIO11
  # SCL = GPIO10
  # ----------------------------------------------------------

  - id: io_i2c
    sda: GPIO11
    scl: GPIO10
    scan: true


# ============================================================
# TCA9554
# ============================================================

pca9554:

  - id: tca9554_dev
    address: 0x20
    i2c_id: io_i2c


# ============================================================
# TIME
# ============================================================

time:

  - platform: sntp
    id: local_time
    timezone: Europe/Amsterdam

    servers:
      - pool.ntp.org
      - nl.pool.ntp.org


# ============================================================
# HOME ASSISTANT DATA
# ============================================================

sensor:

  # ----------------------------------------------------------
  # Solar production
  # ----------------------------------------------------------

  - platform: homeassistant
    id: solar_power
    entity_id: sensor.solis_1031720262250153_c0_5d_89_ec_4e_37_pv_total_1_actual_power_total_s
    internal: true


  # ----------------------------------------------------------
  # Battery
  # ----------------------------------------------------------

  - platform: homeassistant
    id: battery_level
    entity_id: sensor.batterij_bruikbaar
    internal: true


  # ----------------------------------------------------------
  # Salt level
  # ----------------------------------------------------------

  - platform: homeassistant
    id: salt_level
    entity_id: sensor.zoutlevelsensor_salt_level_percentage
    internal: true


  # ----------------------------------------------------------
  # Weather temperature
  # ----------------------------------------------------------

  - platform: homeassistant
    id: weather_temperature
    entity_id: weather.huis
    attribute: temperature
    internal: true


# ============================================================
# WEATHER CONDITION
# ============================================================

text_sensor:

  - platform: homeassistant
    id: weather_condition
    entity_id: weather.huis
    internal: true


# ============================================================
# DISPLAY QSPI BUS
# ============================================================

spi:

  - id: display_qspi
    type: quad

    clk_pin: GPIO40

    data_pins:
      - GPIO46
      - GPIO45
      - GPIO42
      - GPIO41


# ============================================================
# DISPLAY BACKLIGHT
# GPIO5
# ============================================================

output:

  - platform: ledc
    id: display_backlight_output
    pin: GPIO5
    frequency: 1000Hz


light:

  - platform: monochromatic
    id: display_backlight
    name: "Display Backlight"
    output: display_backlight_output
    restore_mode: ALWAYS_ON


# ============================================================
# AUDIO - PCM5101
# Official Waveshare demo pins:
# BCLK = GPIO48
# LRCLK = GPIO38
# DOUT = GPIO47
# ============================================================

i2s_audio:
  - id: audio_i2s
    i2s_lrclk_pin: GPIO38
    i2s_bclk_pin: GPIO48

speaker:
  - platform: i2s_audio
    id: woosh_speaker
    dac_type: external
    i2s_audio_id: audio_i2s
    i2s_dout_pin: GPIO47
    sample_rate: 16000
    bits_per_sample: 16bit
    channel: mono
    buffer_duration: 100ms
    timeout: 500ms


# ============================================================
# DISPLAY
# ============================================================

display:

  - platform: mipi_spi

    id: main_display

    model: JC3636W518

    spi_id: display_qspi

    bus_mode: quad

    data_rate: 40MHz

    cs_pin: GPIO21

    reset_pin:
      pca9554: tca9554_dev
      number: 1

    color_order: rgb

    invert_colors: true

    pixel_mode: 16bit

    color_depth: 16

    rotation: 0

    auto_clear_enabled: true

    update_interval: 500ms


    # ========================================================
    # DISPLAY LAMBDA
    # ========================================================

    lambda: |-

      // ======================================================
      // COLORS
      // ======================================================

      const auto WHITE  = Color(255, 255, 255);
      const auto BLACK  = Color(0, 0, 0);
      const auto GREY   = Color(70, 75, 80);
      const auto RED    = Color(255, 40, 40);
      const auto GREEN  = Color(0, 255, 90);
      const auto YELLOW = Color(255, 220, 0);


      // ======================================================
      // COMMON
      // ======================================================

      const int cx = 180;
      const int cy = 180;

      const float PI = 3.14159265f;


      // ======================================================
      // THICK STAGED OPEN GAUGE
      // ======================================================
      // 270 degree gauge, OPEN AT THE BOTTOM.
      // Direction: lower-left -> top -> lower-right.
      // RED -> YELLOW -> GREEN stages.
      // ======================================================

      auto draw_staged_gauge =
        [&](int progress,
            int p1,
            int p2,
            Color c1,
            Color c2,
            Color c3) {

          if (progress < 0)
            progress = 0;

          if (progress > 100)
            progress = 100;

          const float r = 145.0f;
          const int ring_width = 22;

          // 270 degree arc.
          // 135 degrees = lower-left.
          // 405 degrees = lower-right.
          // Therefore the opening is at the bottom.
          const float start_angle = 135.0f;

          // ----------------------------------------------------
          // Complete grey background arc
          // ----------------------------------------------------

          for (int i = 0; i <= 270; i++) {

            float angle =
              (start_angle + i) * PI / 180.0f;

            int x =
              cx + (int)(cos(angle) * r);

            int y =
              cy + (int)(sin(angle) * r);

            it.filled_circle(
              x,
              y,
              ring_width / 2,
              GREY
            );
          }

          // ----------------------------------------------------
          // Coloured stages
          // ----------------------------------------------------

          for (int i = 0; i <= 270; i++) {

            int p =
              (int)((float)i / 270.0f * 100.0f);

            Color stage = c3;

            if (p < p1)
              stage = c1;
            else if (p < p2)
              stage = c2;

            float angle =
              (start_angle + i) * PI / 180.0f;

            int x =
              cx + (int)(cos(angle) * r);

            int y =
              cy + (int)(sin(angle) * r);

            it.filled_circle(
              x,
              y,
              ring_width / 2,
              stage
            );
          }

          // ----------------------------------------------------
          // Hide stage colours beyond current value
          // ----------------------------------------------------

          int progress_steps =
            (int)((float)progress / 100.0f * 270.0f);

          for (int i = progress_steps + 1; i <= 270; i++) {

            float angle =
              (start_angle + i) * PI / 180.0f;

            int x =
              cx + (int)(cos(angle) * r);

            int y =
              cy + (int)(sin(angle) * r);

            it.filled_circle(
              x,
              y,
              ring_width / 2,
              GREY
            );
          }

          // ----------------------------------------------------
          // Active coloured portion
          // ----------------------------------------------------

          for (int i = 0; i <= progress_steps; i++) {

            int p =
              (int)((float)i / 270.0f * 100.0f);

            Color stage = c3;

            if (p < p1)
              stage = c1;
            else if (p < p2)
              stage = c2;

            float angle =
              (start_angle + i) * PI / 180.0f;

            int x =
              cx + (int)(cos(angle) * r);

            int y =
              cy + (int)(sin(angle) * r);

            it.filled_circle(
              x,
              y,
              ring_width / 2,
              stage
            );
          }
        };


      // ======================================================
      // BACKGROUND
      // ======================================================

      it.fill(BLACK);


      // ======================================================
      // PAGE: page_klok
      // ======================================================

      if (id(current_page) == id(page_klok)) {

        // ----------------------------------------------------
        // OUTER RING
        // ----------------------------------------------------

        it.circle(
          cx,
          cy,
          168,
          GREY
        );

        it.circle(
          cx,
          cy,
          167,
          WHITE
        );


        // ----------------------------------------------------
        // CLOCK MARKERS
        // ----------------------------------------------------

        for (int i = 0; i < 60; i++) {

          float angle =
            ((float)i * 6.0f - 90.0f)
            * PI / 180.0f;

          int r_outer = 163;

          int r_inner;

          if (i % 5 == 0)
            r_inner = 149;
          else
            r_inner = 156;


          int x1 =
            cx + (int)(cos(angle) * r_inner);

          int y1 =
            cy + (int)(sin(angle) * r_inner);

          int x2 =
            cx + (int)(cos(angle) * r_outer);

          int y2 =
            cy + (int)(sin(angle) * r_outer);


          if (i % 5 == 0) {

            it.line(
              x1 - 1,
              y1,
              x2 - 1,
              y2,
              WHITE
            );

            it.line(
              x1,
              y1,
              x2,
              y2,
              WHITE
            );

            it.line(
              x1 + 1,
              y1,
              x2 + 1,
              y2,
              WHITE
            );

          } else {

            it.line(
              x1,
              y1,
              x2,
              y2,
              WHITE
            );
          }
        }


        // ----------------------------------------------------
        // THICK HAND FUNCTION
        // ----------------------------------------------------

        auto thick_hand =
          [&](float angle_deg,
              float r_start,
              float r_end,
              float width,
              Color color) {

            float angle =
              (angle_deg - 90.0f)
              * PI / 180.0f;

            float dx = cos(angle);
            float dy = sin(angle);

            float px = -dy;
            float py = dx;

            float x1 =
              cx + dx * r_start;

            float y1 =
              cy + dy * r_start;

            float x2 =
              cx + dx * r_end;

            float y2 =
              cy + dy * r_end;

            float half =
              width / 2.0f;


            int ax =
              (int)(x1 + px * half);

            int ay =
              (int)(y1 + py * half);

            int bx =
              (int)(x1 - px * half);

            int by =
              (int)(y1 - py * half);

            int cx2 =
              (int)(x2 - px * half);

            int cy2 =
              (int)(y2 - py * half);

            int dx2 =
              (int)(x2 + px * half);

            int dy2 =
              (int)(y2 + py * half);


            it.filled_triangle(
              ax, ay,
              bx, by,
              cx2, cy2,
              color
            );

            it.filled_triangle(
              ax, ay,
              cx2, cy2,
              dx2, dy2,
              color
            );
          };


        // ----------------------------------------------------
        // TIME
        // ----------------------------------------------------

        auto now = id(local_time).now();

        float seconds =
          now.second;

        float minutes =
          now.minute +
          seconds / 60.0f;

        float hours =
          (now.hour % 12) +
          minutes / 60.0f;


        // ----------------------------------------------------
        // HANDS
        // ----------------------------------------------------

        thick_hand(
          hours * 30.0f,
          -10,
          82,
          13,
          WHITE
        );

        thick_hand(
          minutes * 6.0f,
          -15,
          125,
          10,
          WHITE
        );

        thick_hand(
          seconds * 6.0f,
          -28,
          147,
          4,
          RED
        );


        // ----------------------------------------------------
        // CENTER HUB
        // ----------------------------------------------------

        it.filled_circle(
          cx,
          cy,
          16,
          RED
        );

        it.filled_circle(
          cx,
          cy,
          5,
          WHITE
        );
      }


      // ======================================================
      // PAGE: page_zonnepanelen
      // ======================================================

      else if (
        id(current_page) ==
        id(page_zonnepanelen)
      ) {

        float value =
          id(solar_power).state;

        if (isnan(value))
          value = 0;

        if (value < 0)
          value = 0;

        if (value > 5000)
          value = 5000;


        // ----------------------------------------------------
        // THICK STAGED GAUGE
        // ----------------------------------------------------

        int percentage =
          (int)(value / 5000.0f * 100.0f);

        draw_staged_gauge(
          percentage,
          20,
          40,
          RED,
          YELLOW,
          GREEN
        );


        // ----------------------------------------------------
        // VALUE
        // ----------------------------------------------------

        it.printf(
          cx,
          115,
          id(font_large),
          TextAlign::CENTER,
          "%.2f",
          value / 1000.0f
        );


        // ----------------------------------------------------
        // UNIT
        // ----------------------------------------------------

        it.printf(
          cx,
          175,
          id(font_medium),
          TextAlign::CENTER,
          "kW"
        );


        // ----------------------------------------------------
        // LABEL
        // ----------------------------------------------------

        it.printf(
          cx,
          225,
          id(font_small),
          TextAlign::CENTER,
          "SOLAR PANELS"
        );


        // No status text on the solar page.
      }


      // ======================================================
      // PAGE: page_batterij
      // ======================================================

      else if (
        id(current_page) ==
        id(page_batterij)
      ) {

        float value =
          id(battery_level).state;

        if (isnan(value))
          value = 0;

        if (value < 0)
          value = 0;

        if (value > 100)
          value = 100;


        // ----------------------------------------------------
        // THICK STAGED GAUGE
        // ----------------------------------------------------

        draw_staged_gauge(
          (int)value,
          25,
          50,
          RED,
          YELLOW,
          GREEN
        );


        // ----------------------------------------------------
        // VALUE
        // ----------------------------------------------------

        it.printf(
          cx,
          115,
          id(font_xlarge),
          TextAlign::CENTER,
          "%.0f",
          value
        );


        // ----------------------------------------------------
        // UNIT
        // ----------------------------------------------------

        it.printf(
          cx,
          180,
          id(font_medium),
          TextAlign::CENTER,
          "%%"
        );


        // ----------------------------------------------------
        // LABEL
        // ----------------------------------------------------

        it.printf(
          cx,
          225,
          id(font_small),
          TextAlign::CENTER,
          "BATTERY"
        );


        // No status text on the battery page.
      }


      // ======================================================
      // PAGE: page_weer
      // ======================================================

      else if (
        id(current_page) ==
        id(page_weer)
      ) {

        float temperature =
          id(weather_temperature).state;

        if (isnan(temperature))
          temperature = 0;


        // ----------------------------------------------------
        // OUTER CIRCLE
        // ----------------------------------------------------

        it.circle(
          cx,
          cy,
          168,
          GREY
        );


        // ----------------------------------------------------
        // TEMPERATURE
        // ----------------------------------------------------

        it.printf(
          cx,
          75,
          id(font_xlarge),
          TextAlign::CENTER,
          "%.1f",
          temperature
        );


        it.printf(
          cx,
          140,
          id(font_medium),
          TextAlign::CENTER,
          "°C"
        );


        // ----------------------------------------------------
        // WEATHER CONDITION
        // ----------------------------------------------------

        std::string condition =
          id(weather_condition).state;

        std::string condition_display =
          "UNKNOWN";


        if (condition == "sunny")
          condition_display = "SUNNY";

        else if (condition == "clear-night")
          condition_display = "CLEAR";

        else if (condition == "partlycloudy")
          condition_display = "PARTLY CLOUDY";

        else if (condition == "cloudy")
          condition_display = "CLOUDY";

        else if (condition == "rainy")
          condition_display = "RAIN";

        else if (condition == "pouring")
          condition_display = "HEAVY RAIN";

        else if (condition == "snowy")
          condition_display = "SNOW";

        else if (condition == "snowy-rainy")
          condition_display = "SLEET";

        else if (condition == "windy")
          condition_display = "WINDY";

        else if (condition == "fog")
          condition_display = "FOG";


        // ----------------------------------------------------
        // WEATHER ICON
        // ----------------------------------------------------

        if (
          condition == "sunny" ||
          condition == "clear-night"
        ) {

          it.filled_circle(
            cx,
            205,
            30,
            YELLOW
          );

        } else {

          it.filled_circle(
            155,
            210,
            22,
            WHITE
          );

          it.filled_circle(
            180,
            198,
            30,
            WHITE
          );

          it.filled_circle(
            210,
            210,
            22,
            WHITE
          );

          it.filled_rectangle(
            155,
            205,
            55,
            27,
            WHITE
          );
        }


        // ----------------------------------------------------
        // CONDITION TEXT
        // ----------------------------------------------------

        it.printf(
          cx,
          270,
          id(font_small),
          TextAlign::CENTER,
          "%s",
          condition_display.c_str()
        );
      }


      // ======================================================
      // PAGE: page_zout
      // ======================================================

      else if (
        id(current_page) ==
        id(page_zout)
      ) {

        float value =
          id(salt_level).state;

        if (isnan(value))
          value = 0;

        if (value < 0)
          value = 0;

        if (value > 100)
          value = 100;


        // ----------------------------------------------------
        // THICK STAGED GAUGE
        // ----------------------------------------------------

        draw_staged_gauge(
          (int)value,
          10,
          25,
          RED,
          YELLOW,
          GREEN
        );


        // ----------------------------------------------------
        // VALUE
        // ----------------------------------------------------

        it.printf(
          cx,
          115,
          id(font_xlarge),
          TextAlign::CENTER,
          "%.0f",
          value
        );


        // ----------------------------------------------------
        // UNIT
        // ----------------------------------------------------

        it.printf(
          cx,
          180,
          id(font_medium),
          TextAlign::CENTER,
          "%%"
        );


        // ----------------------------------------------------
        // LABEL
        // ----------------------------------------------------

        it.printf(
          cx,
          225,
          id(font_small),
          TextAlign::CENTER,
          "SALT LEVEL"
        );


        // ----------------------------------------------------
        // STATUS
        // ----------------------------------------------------

        if (value >= 25) {

          it.printf(
            cx,
            260,
            id(font_medium),
            TextAlign::CENTER,
            "OK"
          );

        } else if (value >= 10) {

          it.printf(
            cx,
            260,
            id(font_medium),
            TextAlign::CENTER,
            "LOW"
          );

        } else {

          it.printf(
            cx,
            260,
            id(font_medium),
            TextAlign::CENTER,
            "REFILL"
          );
        }
      }


# ============================================================
# FONTS
# ============================================================

font:

  - file: "gfonts://Roboto"
    id: font_small
    size: 20

  - file: "gfonts://Roboto"
    id: font_medium
    size: 30

  - file: "gfonts://Roboto"
    id: font_large
    size: 55

  - file: "gfonts://Roboto"
    id: font_xlarge
    size: 70


# ============================================================
# TOUCHSCREEN
# ============================================================

touchscreen:

  - platform: cst816

    id: touchscreen_main

    i2c_id: touch_i2c

    interrupt_pin: GPIO4

    reset_pin:
      pca9554: tca9554_dev
      number: 0

    skip_probe: true


    # --------------------------------------------------------
    # TOUCH START
    # --------------------------------------------------------

    on_touch:

      - lambda: |-

          id(swipe_handled) = false;

          ESP_LOGD(
            "touch",
            "Touch started"
          );


    # --------------------------------------------------------
    # TOUCH UPDATE
    # --------------------------------------------------------

    on_update:

      - lambda: |-

          for (auto &touch_point : touches) {

            if (
              touch_point.state == 1 ||
              touch_point.state == 2
            ) {

              int dx =
                touch_point.x -
                touch_point.x_org;


              // ==================================================
              // SWIPE LEFT
              // ==================================================

              if (
                !id(swipe_handled) &&
                dx <= -70
              ) {

                id(current_page)++;

                if (
                  id(current_page) >
                  id(page_zout)
                ) {
                  id(current_page) =
                    id(page_klok);
                }


                id(swipe_handled) = true;


                // Pause automatic rotation
                // for 20 seconds

                id(auto_rotate_pause_until) =
                  millis() + 20000;

                id(last_page_change) =
                  millis();


                ESP_LOGD(
                  "touch",
                  "Swipe LEFT -> page %d",
                  id(current_page)
                );

                // --------------------------------------------------
                // SWIPE SOUND - short "woosh"
                // --------------------------------------------------
                // Generate a short 16 kHz / 16-bit mono sweep.
                // No external audio file is required.
                {
                  const uint32_t sample_rate = 16000;
                  const uint32_t samples = 2400;  // 150 ms
                  std::vector<uint8_t> audio;
                  audio.resize(samples * 2);

                  const float two_pi = 6.28318530718f;

                  for (uint32_t n = 0; n < samples; n++) {
                    float t = (float)n / (float)samples;

                    // Fast frequency sweep: high -> low.
                    float freq =
                      1400.0f -
                      (1150.0f * t);

                    // Smooth attack/decay envelope.
                    float envelope = 1.0f;

                    if (t < 0.08f)
                      envelope = t / 0.08f;

                    if (t > 0.70f)
                      envelope = (1.0f - t) / 0.30f;

                    float sample =
                      sinf(two_pi * freq *
                           ((float)n / (float)sample_rate));

                    // Make it sound more like a "whoosh" than a beep.
                    sample *= envelope * 0.28f;

                    int16_t s =
                      (int16_t)(sample * 32767.0f);

                    audio[n * 2] =
                      (uint8_t)(s & 0xFF);

                    audio[n * 2 + 1] =
                      (uint8_t)((s >> 8) & 0xFF);
                  }

                  id(woosh_speaker).play(audio.data(), audio.size());
                }
              }


              // ==================================================
              // SWIPE RIGHT
              // ==================================================

              else if (
                !id(swipe_handled) &&
                dx >= 70
              ) {

                id(current_page)--;

                if (
                  id(current_page) <
                  id(page_klok)
                ) {
                  id(current_page) =
                    id(page_zout);
                }


                id(swipe_handled) = true;


                // Pause automatic rotation
                // for 20 seconds

                id(auto_rotate_pause_until) =
                  millis() + 20000;

                id(last_page_change) =
                  millis();


                ESP_LOGD(
                  "touch",
                  "Swipe RIGHT -> page %d",
                  id(current_page)
                );

                // --------------------------------------------------
                // SWIPE SOUND - short "woosh"
                // --------------------------------------------------
                // Generate a short 16 kHz / 16-bit mono sweep.
                // No external audio file is required.
                {
                  const uint32_t sample_rate = 16000;
                  const uint32_t samples = 2400;  // 150 ms
                  std::vector<uint8_t> audio;
                  audio.resize(samples * 2);

                  const float two_pi = 6.28318530718f;

                  for (uint32_t n = 0; n < samples; n++) {
                    float t = (float)n / (float)samples;

                    // Fast frequency sweep: high -> low.
                    float freq =
                      1400.0f -
                      (1150.0f * t);

                    // Smooth attack/decay envelope.
                    float envelope = 1.0f;

                    if (t < 0.08f)
                      envelope = t / 0.08f;

                    if (t > 0.70f)
                      envelope = (1.0f - t) / 0.30f;

                    float sample =
                      sinf(two_pi * freq *
                           ((float)n / (float)sample_rate));

                    // Make it sound more like a "whoosh" than a beep.
                    sample *= envelope * 0.28f;

                    int16_t s =
                      (int16_t)(sample * 32767.0f);

                    audio[n * 2] =
                      (uint8_t)(s & 0xFF);

                    audio[n * 2 + 1] =
                      (uint8_t)((s >> 8) & 0xFF);
                  }

                  id(woosh_speaker).play(audio.data(), audio.size());
                }
              }
            }
          }


    # --------------------------------------------------------
    # RELEASE
    # --------------------------------------------------------

    on_release:

      - lambda: |-

          // Do NOT reset swipe_handled here.
          // The next on_touch event starts a new gesture and resets it.
          // This prevents a release/update event ordering issue from
          // causing subsequent swipes to be ignored.


# ============================================================
# AUTOMATIC PAGE ROTATION
# ============================================================

interval:

  - interval: 250ms

    then:

      - lambda: |-

          // --------------------------------------------------
          // Automatic rotation paused?
          // --------------------------------------------------

          if (
            millis() <
            id(auto_rotate_pause_until)
          ) {
            return;
          }


          // --------------------------------------------------
          // Change page every 5 seconds
          // --------------------------------------------------

          if (
            millis() -
            id(last_page_change)
            >= 5000
          ) {

            id(current_page)++;


            if (
              id(current_page) >
              id(page_zout)
            ) {
              id(current_page) =
                id(page_klok);
            }


            id(last_page_change) =
              millis();


            ESP_LOGD(
              "display",
              "Automatic page -> %d",
              id(current_page)
            );
          }
